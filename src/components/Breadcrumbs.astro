---
/** Breadcrumb trail plus its BreadcrumbList structured data. The last item is the current page. */
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.name,
    item: new URL(it.href ?? Astro.url.pathname, site).href,
  })),
};
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
