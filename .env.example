# Copy to .env for local work, and add the same keys in Vercel → Settings → Environment Variables.

# Canonical domain (no trailing slash)
SITE_URL=https://wrenchtheory.com

# Google AdSense — leave empty until the site is approved.
PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_HEADER=       # ad unit id for the leaderboard under the header
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=   # in-article unit
PUBLIC_ADSENSE_SLOT_SIDEBAR=      # sidebar unit
PUBLIC_ADSENSE_SLOT_END=          # end-of-article unit
PUBLIC_ADSENSE_SLOT_HOME=         # homepage in-feed unit
# Show dashed placeholders where ads will go (useful for design review on a preview deploy)
PUBLIC_SHOW_AD_PLACEHOLDERS=false

# Google Analytics 4 measurement id (G-XXXXXXX) and Search Console verification token
PUBLIC_GA_ID=
PUBLIC_GSC_VERIFICATION=

# Form endpoints (e.g. Formspree, Buttondown, ConvertKit). Forms POST to these URLs.
PUBLIC_NEWSLETTER_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=
